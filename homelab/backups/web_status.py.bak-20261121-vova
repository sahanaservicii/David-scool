class Handler(BaseHTTPRequestHandler):
    server_version = "HomelabStatus/0.1"

    def _send(self, code: int, body: bytes, content_type: str = "text/plain; charset=utf-8"):
        self.send_response(code)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, fmt, *args):  # quieter
        sys.stderr.write(f"[web_status] {self.address_string()} {fmt % args}\n")

    def do_GET(self):
        parsed = urlparse(self.path)
        if parsed.path == "/" or parsed.path == "/index.html":
            return self._send(200, INDEX_HTML.encode("utf-8"), "text/html; charset=utf-8")
        if parsed.path == "/api/data":
            payload = build_payload()
            return self._send(200, json.dumps(payload, ensure_ascii=False).encode("utf-8"), "application/json; charset=utf-8")
        if parsed.path == "/api/health":
            return self._send(200, b"ok")
        self._send(404, b"not found")

    def do_POST(self):
        parsed = urlparse(self.path)
        qs = parse_qs(parsed.query)
        if parsed.path == "/api/run":
            action = (qs.get("action") or [""])[0]
            if action == "doctor":
                res = run_homelab(["doctor"], timeout=90)
            elif action == "scan":
                # scan active network; keep bounded
                res = run_homelab(["scan"], timeout=300)
            elif action == "inventory":
                res = run_homelab(["inventory"], timeout=60)
            else:
                return self._send(400, json.dumps({"ok": False, "error": "unknown action"}, ensure_ascii=False).encode("utf-8"), "application/json; charset=utf-8")
            return self._send(200, json.dumps(res, ensure_ascii=False).encode("utf-8"), "application/json; charset=utf-8")
        self._send(404, b"not found")


def parse_args():
    ap = argparse.ArgumentParser(description="Локальная веб-панель статуса homelab (read-only)")
    ap.add_argument("--host", default="127.0.0.1", help="Хост bind (по умолчанию 127.0.0.1)")
    ap.add_argument("--port", type=int, default=8766, help="Порт (по умолчанию 8766)")
    return ap.parse_args()


def main() -> int:
    args = parse_args()
    host = args.host
    port = args.port
    # Safety: default localhost; if user binds non-localhost, warn loudly
    if host not in ("127.0.0.1", "localhost", "::1"):
        print(f"ВНИМАНИЕ: bind на {host}:{port} открывает панель не только локально.", file=sys.stderr)
    srv = ThreadingHTTPServer((host, port), Handler)
    print(f"Homelab Status UI: http://{host}:{port}  (Ctrl+C для остановки)")
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        srv.server_close()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
