#!/usr/bin/env python3
"""
Локальная веб-панель статуса домашней инфраструктуры (read-only).

Две вкладки:
1) Сетка квартиры (активная локация из homelab.json) — устройства и статусы.
2) Роутер и подключённые устройства — данные из scan/inventory/ARP (без UI роутера).

Источники: homelab.json, state/scan.json, doctor/scan/inventory (по запросу).
Только localhost, без секретов, без изменений конфигурации устройств.
"""

from __future__ import annotations

import argparse
import html
import json
import os
import socket
import subprocess
import sys
import time
from datetime import datetime
from http import HTTPStatus
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import parse_qs, urlparse

ROOT = Path(__file__).resolve().parent
CONFIG_PATH = ROOT / "homelab.json"
STATE_DIR = ROOT / "state"
SCAN_PATH = STATE_DIR / "scan.json"
HOMELAB_PY = ROOT / "homelab.py"


def now_ts() -> str:
    return datetime.now().strftime("%Y-%m-%d %H:%M:%S")


def load_json(path: Path, default):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return default


def load_config() -> dict:
    cfg = load_json(CONFIG_PATH, {})
    cfg.setdefault("network", "192.168.1.0/24")
    cfg.setdefault("active_location", "default")
    cfg.setdefault("locations", {})
    return cfg


def load_scan() -> dict:
    return load_json(SCAN_PATH, {})


def active_location(cfg: dict) -> tuple[str, dict]:
    name = cfg.get("active_location") or "default"
    loc = cfg.get("locations", {}).get(name)
    if isinstance(loc, dict):
        merged = dict(loc)
        # top-level fields as fallback
        for k in ("network", "gateway", "router", "home_assistant", "android", "cameras", "other"):
            if k not in merged and k in cfg:
                merged[k] = cfg[k]
        merged.setdefault("network", cfg.get("network", ""))
        merged.setdefault("gateway", cfg.get("gateway", ""))
        return name, merged
    # fallback: treat top-level as location
    return name, {
        "network": cfg.get("network", ""),
        "gateway": cfg.get("gateway", ""),
        "router": cfg.get("router", {}),
        "home_assistant": cfg.get("home_assistant", {}),
        "android": cfg.get("android", []),
        "cameras": cfg.get("cameras", []),
        "other": cfg.get("other", []),
    }


def collect_devices(cfg: dict, loc: dict, scan: dict) -> list[dict]:
    scan_hosts = scan.get("hosts", {}) if isinstance(scan.get("hosts"), dict) else {}
    known = {}

    def add(item: dict, kind_fallback: str):
        if not isinstance(item, dict):
            return
        host = str(item.get("host") or "").strip()
        if not host:
            return
        entry = known.get(host, {})
        entry.update({
            "host": host,
            "name": item.get("name") or entry.get("name") or host,
            "kind": item.get("kind") or entry.get("kind") or kind_fallback,
            "note": item.get("note") or entry.get("note") or "",
            "source": "inventory",
        })
        known[host] = entry

    for section in ("router", "home_assistant"):
        item = loc.get(section)
        if isinstance(item, dict):
            add(dict(item, name=item.get("name") or section), section)
    for section in ("android", "cameras", "other"):
        for item in loc.get(section) or []:
            add(item, section)

    # include scan-only hosts
    for host, ports in scan_hosts.items():
        if host not in known:
            known[host] = {
                "host": host,
                "name": host,
                "kind": "discovered",
                "note": "Найден сканированием, не описан в inventory",
                "source": "scan",
            }
        known[host]["open_ports"] = ports
        known[host]["status"] = "up" if ports else "unknown"

    for host, dev in known.items():
        ports = dev.get("open_ports")
        if ports is None:
            ports = scan_hosts.get(host, [])
            dev["open_ports"] = ports
        dev["status"] = dev.get("status") or ("up" if ports else "unknown")
        dev["open_ports"] = sorted(set(int(p) for p in ports if str(p).isdigit()))
    # sort by IP
    def ip_key(h):
        try:
            return tuple(int(x) for x in h.split("."))
        except Exception:
            return (999, 999, 999, 999)
    return sorted(known.values(), key=lambda d: ip_key(d.get("host", "")))


def read_arp() -> list[dict]:
    rows = []
    # /proc/net/arp
    try:
        lines = Path("/proc/net/arp").read_text(encoding="utf-8", errors="replace").splitlines()
        for line in lines[1:]:
            parts = line.split()
            if len(parts) >= 6:
                ip, hwtype, flags, mac, mask, dev = parts[:6]
                if mac == "00:00:00:00:00:00":
                    continue
                rows.append({"ip": ip, "mac": mac, "dev": dev, "flags": flags, "source": "arp"})
    except Exception:
        pass
    # ip neigh fallback/merge
    try:
        p = subprocess.run(["ip", "neigh"], capture_output=True, text=True, timeout=5)
        if p.returncode == 0:
            seen = {(r["ip"], r.get("dev")) for r in rows}
            for line in p.stdout.splitlines():
                parts = line.split()
                if len(parts) < 4:
                    continue
                ip = parts[0]
                dev = parts[2] if len(parts) > 2 and parts[1] == "dev" else ""
                mac = ""
                state = parts[-1]
                if "lladdr" in parts:
                    mac = parts[parts.index("lladdr") + 1]
                key = (ip, dev)
                if key not in seen and mac and mac != "00:00:00:00:00:00":
                    rows.append({"ip": ip, "mac": mac, "dev": dev, "flags": state, "source": "ip-neigh"})
    except Exception:
        pass
    # dedupe by ip prefer arp
    by_ip = {}
    for r in rows:
        by_ip.setdefault(r["ip"], r)
    def ip_key(h):
        try:
            return tuple(int(x) for x in h.split("."))
        except Exception:
            return (999, 999, 999, 999)
    return sorted(by_ip.values(), key=lambda r: ip_key(r.get("ip", "")))


def run_homelab(args: list[str], timeout: int = 120) -> dict:
    cmd = [sys.executable, str(HOMELAB_PY)] + args
    started = time.time()
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, cwd=str(ROOT))
        return {
            "ok": p.returncode == 0,
            "returncode": p.returncode,
            "cmd": cmd,
            "stdout": (p.stdout or "")[-12000:],
            "stderr": (p.stderr or "")[-4000:],
            "duration_s": round(time.time() - started, 2),
        }
    except subprocess.TimeoutExpired as e:
        out = e.stdout.decode("utf-8", "replace") if isinstance(e.stdout, bytes) else (e.stdout or "")
        err = e.stderr.decode("utf-8", "replace") if isinstance(e.stderr, bytes) else (e.stderr or "")
        return {
            "ok": False,
            "returncode": 124,
            "cmd": cmd,
            "stdout": out[-12000:],
            "stderr": (err + f"\nТаймаут {timeout} с")[-4000:],
            "duration_s": round(time.time() - started, 2),
        }
    except Exception as e:
        return {"ok": False, "returncode": 1, "cmd": cmd, "stdout": "", "stderr": str(e), "duration_s": round(time.time() - started, 2)}


def build_payload() -> dict:
    cfg = load_config()
    scan = load_scan()
    loc_name, loc = active_location(cfg)
    devices = collect_devices(cfg, loc, scan)
    arp = read_arp()
    scan_hosts = scan.get("hosts", {}) if isinstance(scan.get("hosts"), dict) else {}

    # Enrich arp rows with known device names and open ports
    known_by_host = {d["host"]: d for d in devices}
    arp_enriched = []
    for r in arp:
        ip = r.get("ip")
        dev = known_by_host.get(ip, {})
        arp_enriched.append({
            **r,
            "name": dev.get("name") or ip,
            "kind": dev.get("kind") or "discovered",
            "note": dev.get("note") or "",
            "open_ports": dev.get("open_ports") or scan_hosts.get(ip, []),
            "status": "up" if (dev.get("open_ports") or scan_hosts.get(ip)) or r.get("flags") not in ("FAILED",) else "seen",
        })

    router = loc.get("router") if isinstance(loc.get("router"), dict) else {}
    gateway = loc.get("gateway") or cfg.get("gateway") or router.get("host") or ""

    # Router tab: "connected devices" = scan hosts in same /24 as gateway/network, plus arp
    net = loc.get("network") or cfg.get("network") or ""
    prefix = ".".join(net.split(".")[:3]) if net.count(".") >= 3 else ""
    connected = []
    seen_ips = set()
    for d in devices:
        ip = d.get("host", "")
        if prefix and ip.startswith(prefix + "."):
            connected.append(d)
            seen_ips.add(ip)
    for r in arp_enriched:
        ip = r.get("ip", "")
        if prefix and ip.startswith(prefix + ".") and ip not in seen_ips:
            connected.append({
                "host": ip,
                "name": r.get("name") or ip,
                "kind": r.get("kind") or "arp",
                "note": r.get("note") or f"ARP/neighbor ({r.get('dev','')})",
                "open_ports": r.get("open_ports") or [],
                "status": r.get("status") or "seen",
                "source": r.get("source", "arp"),
                "mac": r.get("mac", ""),
            })
            seen_ips.add(ip)

    def ip_key(h):
        try:
            return tuple(int(x) for x in h.split("."))
        except Exception:
            return (999, 999, 999, 999)
    connected = sorted(connected, key=lambda d: ip_key(d.get("host", "")))

    return {
        "generated_at": now_ts(),
        "active_location": loc_name,
        "location": {
            "name": loc_name,
            "network": net,
            "gateway": gateway,
            "router": {
                "name": router.get("name") or "router",
                "host": router.get("host") or gateway,
                "kind": router.get("kind") or "",
                "note": router.get("note") or "",
            },
        },
        "scan": {
            "timestamp": scan.get("timestamp"),
            "network": scan.get("network"),
            "count": scan.get("count"),
            "path": str(SCAN_PATH),
            "exists": SCAN_PATH.exists(),
        },
        "devices": devices,
        "arp": arp_enriched,
        "connected": connected,
        "warnings": build_warnings(cfg, loc_name, loc, scan),
    }


def build_warnings(cfg: dict, loc_name: str, loc: dict, scan: dict) -> list[str]:
    warnings = []
    net = loc.get("network") or cfg.get("network")
    scan_net = scan.get("network")
    if scan.get("timestamp"):
        # freshness
        try:
            ts = datetime.strptime(scan["timestamp"], "%Y-%m-%d %H:%M:%S")
            age_min = (datetime.now() - ts).total_seconds() / 60
            if age_min > 60:
                warnings.append(f"scan.json устарел: {scan['timestamp']} (~{int(age_min)} мин. назад).")
        except Exception:
            pass
        if scan_net and net and scan_net not in (net, "custom"):
            warnings.append(f"scan.json сеть '{scan_net}' может не совпадать с активной '{net}'.")
        if scan_net == "custom":
            warnings.append("Последний scan.json был пользовательским/частичным (network=custom) — может не отражать всю сеть.")
    else:
        warnings.append("scan.json отсутствует или пуст — нажмите 'Сканировать сеть' для актуальных портов/статусов.")
    gw = loc.get("gateway") or cfg.get("gateway")
    if gw and not scan.get("hosts", {}).get(gw):
        warnings.append(f"Шлюз {gw} не отмечен как найденный в последнем scan.json (может быть недоступен или scan неполный).")
    warnings.append("Данные 'подключённых к роутеру' собраны из локальных scan/inventory/ARP, без входа в UI роутера.")
    warnings.append("Live-сканирование запускается только по кнопке и может занять время.")
    return warnings


