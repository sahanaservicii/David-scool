<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- LAN/WireGuard transport: cleartext allowed, payload is HMAC-signed. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
