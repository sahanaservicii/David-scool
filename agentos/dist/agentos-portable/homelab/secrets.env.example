# Секреты homelab. Скопируй в ~/.config/opencode/secrets/homelab.env и chmod 600.
# В git/отчёты/чат не попадает — homelab.py читает файл сам.

# Home Assistant → профиль → долгоживущий токен
HASS_TOKEN=

# Путь к приватному SSH-ключу для root@192.168.1.1 (Dropbear/OpenSSH)
HOMELAB_SSH_KEY=/root/.ssh/id_ed25519

# Необязательно: если SSH на роутере слушает не 22, поправь homelab.json.
# Пароли SSH не используются: только ключи (sshpass не нужен и не ставится).
